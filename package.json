{
  "name": "ai-content-automation",
  "version": "1.0.0",
  "description": "Automation for AI video content",
  "main": "dist/src/automation/main.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.93.2",
    "axios": "^1.6.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.6",
    "googleapis": "^170.1.0",
    "groq-sdk": "^0.3.3",
    "gsap": "^3.15.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "puppeteer": "^25.14.0",
    "sharp": "^0.35.5",
    "supabase": "^2.72.8",
    "tsx": "^4.23.15",
    "wait-on": "^9.0.3",
    "winston": "^3.11.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/gsap": "^3.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "playwright": "^1.41.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "automation": "node --import tsx src/automation/main.ts",
    "typecheck": "npm run typecheck:automation && npm run typecheck:legacy && npm run typecheck:composer",
    "build": "npm run build:automation && npm run build:legacy && npm --prefix reel-composer run build",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "postinstall": "node --import tsx scripts/generate-compat.ts",
    "compat": "node --import tsx scripts/generate-compat.ts",
    "typecheck:legacy": "tsc -p tsconfig.legacy.json --noEmit",
    "build:legacy": "tsc -p tsconfig.legacy.json",
    "typecheck:automation": "tsc --noEmit",
    "typecheck:composer": "npm --prefix reel-composer run typecheck",
    "build:automation": "tsc",
    "syntax": "node --import tsx scripts/check-syntax.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "check:migration": "node --import tsx scripts/check-migration.ts"
  }
}
