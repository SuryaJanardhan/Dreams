# Production runs on GitHub Actions. This file documents its secret names.
GOOGLE_SHEET_ID=your_sheet_id
# Raw service-account JSON, NOT base64. Share the Sheet with client_email.
GOOGLE_CREDENTIALS='{"client_email":"service@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
GEMINI_API_KEY=your_script_key
GEMINI_API_KEY_FOR_VISUALS=your_animation_key
ASSEMBLYAI_API_KEY=your_transcription_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=videos
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token
INSTAGRAM_ACCOUNT_ID=your_numeric_account_id
INSTAGRAM_ACCESS_TOKEN=your_token
FACEBOOK_PAGE_ID=your_numeric_page_id
FACEBOOK_ACCESS_TOKEN=your_token
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=recipient@example.com
# Optional override; otherwise uses assets/Base-audio.txt recovered from the reference sample.
VOICEBOX_REFERENCE_TEXT=
VOICEBOX_MODEL_SIZE=1.7B
PYTHON_EXECUTABLE=python
SHEET_TAB=Sheet1
GRAPH_API_VERSION=v23.0
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
GEMINI_VISUAL_MODEL=gemini-2.5-flash
AUTOMATION_BUDGET_MINUTES=120
